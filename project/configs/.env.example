# ============================================================
# SmartFeedback — шаблон переменных окружения
# Скопируйте в project/.env и заполните реальными значениями.
# Файл .env НЕ коммитится (добавлен в .gitignore).
# ============================================================

# --- Hugging Face ---
# Токен для скачивания моделей/датасетов (при необходимости)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Локальный кеш HF (переопределяет hf_cache_dir из config.yaml)
# HF_HOME=/path/to/huggingface/cache

# --- Пути к артефактам (переопределяют inference.yaml) ---
# BERT_MODEL_PATH=artifacts/rubert_tiny2/final
# BASELINE_MODEL_PATH=artifacts/baseline_pipeline.pkl

# --- Сервис ---
# SERVICE_HOST=0.0.0.0
# SERVICE_PORT=8000

# --- Логирование ---
# LOG_LEVEL=INFO
# LOG_FILE=logs/service.log
